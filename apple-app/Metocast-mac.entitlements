<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The Developer ID build runs with the hardened runtime (scripts/notarize-mac.sh), which
	     refuses these unless asked for. The app and its helpers record the RØDECaster's audio… -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- …and drive Keynote with osascript. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
